{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linkdqueue Desktop",
  "version": "2.0.0",
  "identifier": "com.feoh.linkdqueue.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Linkdqueue Desktop",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; base-uri 'none'; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis", "dmg"],
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements/macos.plist"
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1", "libsecret-1-0"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
